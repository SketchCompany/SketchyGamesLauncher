# Copy this file to `.env` (git-ignored) and fill in real values for local
# builds. In CI, provide these as repository/organization secrets instead.

# --- Build/Publish-Zeit (nur electron-forge, via src/config/secrets.js) ---
# GitHub token with `repo` scope, used by electron-forge to publish releases.
GITHUB_PUBLISH_TOKEN=

# Optional: token to raise GitHub API rate limits when fetching patch notes
# (the app works fine without it; never required, never bundled).
GITHUB_TOKEN=

# Apple credentials for macOS code-signing / notarization (optional).
APPLE_ID=
APPLE_ID_PASSWORD=
APPLE_TEAM_ID=

# --- Laufzeit (Sketchy-Plattform; von src/apiBase.js gelesen) ---
# Bot-Check-Ausnahme der Auth-Routen: MUSS = LAUNCHER_SHARED_SECRET der API sein.
# Achtung: in einem verteilten Client extrahierbar — kein starkes Geheimnis, nur Bot-Abgrenzung.
SKETCHY_LAUNCHER_KEY=
# Web-App (SketchCompanyReact): Quelle der Spiel-Builds (/api/launcher/games, /api/download/games/:id).
SKETCHY_WEB_BASE="https://sketch-company.de"
# Optional: zentrale API-Basis für lokale Entwicklung (Default https://api.sketch-company.de).
# SKETCHY_API_BASE="http://localhost:3500"
